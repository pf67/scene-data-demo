{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scene construction plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "scaleBasis", "views", "buildings"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "videoEvidence": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of a local, photo-bound video surface manifest." },
    "scaleBasis": { "enum": ["estimated", "measured"], "description": "Use measured only with surveyed ground coordinates in metres." },
    "ground": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "marginPercent": { "type": "number", "minimum": 0, "maximum": 120, "default": 25, "description": "Additional extent per side as a percentage of the site span." },
        "surface": { "enum": ["local", "fields"], "default": "local" },
        "reliefM": { "type": "number", "minimum": 0, "maximum": 6, "default": 0, "description": "Maximum inferred ground relief in unknown areas, in scene metres." },
        "roads": { "type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["points", "widthM"],
          "properties": {
            "points": { "type": "array", "minItems": 2, "maxItems": 24, "items": { "$ref": "#/definitions/xz" } },
            "widthM": { "type": "number", "minimum": 0.3, "maximum": 60 },
            "extendEnds": { "type": "boolean", "default": true }
          }
        }}
      }
    },
    "views": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/definitions/view" } },
    "supplements": { "type": "array", "maxItems": 16, "items": { "$ref": "#/definitions/supplement" } },
    "buildings": { "type": "array", "maxItems": 150, "items": { "$ref": "#/definitions/building" }, "description": "Use an empty array for a ground-only scene." }
  },
  "definitions": {
    "supplement": {
      "type": "object", "additionalProperties": false, "required": ["source","reference","angle","provenance"],
      "properties": {
        "source": {"$ref":"#/definitions/id"}, "reference":{"$ref":"#/definitions/id"},
        "angle":{"type":"number","anyOf":[{"minimum":-180,"maximum":-10},{"minimum":10,"maximum":180}]},
        "provenance":{"enum":["qwen-image-2.1","image-api","imported-synthetic"]},
        "provider":{"enum":["qma","comfyui","openai"]},
        "model":{"type":"string","minLength":1,"maxLength":160},
        "registration":{"enum":["measured","target"]},
        "points":{"type":"array","minItems":6,"maxItems":64,"items":{
          "type":"object","required":["guide","image"],"additionalProperties":false,
          "properties":{"guide":{"$ref":"#/definitions/uv"},"image":{"$ref":"#/definitions/uv"},"check":{"type":"boolean","description":"Withhold this correspondence from camera fitting for independent verification."},
            "world":{"description":"Landmark on a previously reconstructed surface, in the original model's coordinate system.","type":"array","minItems":3,"maxItems":3,"items":{"type":"number","minimum":-10000,"maximum":10000}}}
        }}
      }
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
    "uv": { "description": "Image coordinates divided by width and height; origin top left.", "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
    "xz": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": -10000, "maximum": 10000 } },
    "control": {
      "type": "object", "additionalProperties": false, "required": ["uv", "xz"],
      "properties": { "uv": { "$ref": "#/definitions/uv" }, "xz": { "$ref": "#/definitions/xz" }, "check": { "type": "boolean", "description": "Withhold this point from the camera fit." } }
    },
    "view": {
      "type": "object", "additionalProperties": false, "required": ["source", "fovY", "controls"],
      "allOf": [{ "if": { "required": ["approxPose"] }, "then": { "properties": { "controls": { "maxItems": 0 } } }, "else": { "properties": { "controls": { "minItems": 4 } } } }],
      "properties": {
        "source": { "$ref": "#/definitions/id" },
        "groundMask": { "description": "Optional registered ground support mask aligned with this photo. White permits sampling the ground.", "$ref": "#/definitions/id" },
        "fovY": { "type": "number", "minimum": 12, "maximum": 120, "description": "Vertical field of view in degrees of the supplied oriented image." },
        "focalRatio": { "type": "number", "minimum": 0.5, "maximum": 2, "description": "fx/fy in pixels; default 1." },
        "principal": { "$ref": "#/definitions/uv" },
        "approxPose": { "type": "object", "additionalProperties": false, "required": ["heightM", "pitchDeg"],
          "properties": { "heightM": { "type": "number", "minimum": 0.5, "maximum": 2000 }, "pitchDeg": { "type": "number", "minimum": 1, "maximum": 89 }, "rollDeg": { "type": "number", "minimum": -60, "maximum": 60 } },
          "description": "Estimated single-view camera height, downward pitch and clockwise image roll. Use estimated scale and no controls." },
        "controls": { "type": "array", "maxItems": 64, "items": { "$ref": "#/definitions/control" } }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["source", "roof"],
      "properties": {
        "source": { "$ref": "#/definitions/id" },
        "roof": { "description": "Convex eave polygon in perimeter order. Corner 1 and winding must match across views.", "type": "array", "minItems": 3, "maxItems": 16, "items": { "$ref": "#/definitions/uv" } },
        "base": { "description": "Ground point vertically below roof corner 1.", "$ref": "#/definitions/uv" }
      }
    },
    "building": {
      "type": "object", "additionalProperties": false, "required": ["id", "observations"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "heightM": { "type": "number", "exclusiveMinimum": 0.1, "maximum": 300 },
        "heightSource": { "enum": ["estimated", "measured"] },
        "ridgeRiseM": { "type": "number", "minimum": 0, "maximum": 60, "description": "Gable ridge rise above the eaves, for quadrilaterals only." },
        "observations": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/definitions/observation" } }
      }
    }
  }
}
