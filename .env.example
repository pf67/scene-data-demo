HOST=127.0.0.1
PORT=8090
# Optional OpenAI-compatible Images Edits API. Configure on the server, then restart.
# OPENAI_API_KEY=
# ORBIT_DEFAULT_PROVIDER=openai
# ORBIT_IMAGE_MODELS=gpt-image-2
# Optional alternative gateway. Use ORBIT_IMAGE_API_KEY for that gateway.
# ORBIT_IMAGE_BASE_URL=https://image-service.example/v1
# ORBIT_IMAGE_API_KEY=
# ORBIT_IMAGE_SIZE=auto
# ORBIT_IMAGE_STREAM=true
# Optional Qwen-Image-2.1 service. Use your local ComfyUI address.
# COMFYUI_URL=http://127.0.0.1:8188
# Optional original-photo camera service. Restart the scene server after enabling.
# Its /v1/options supplies camera directions and the starting LoRA strength.
# QMA_API_URL=http://127.0.0.1:8190
# SCENE_PYTHON=python
# SCENE_DATA_DIR=/data
# Optional additional references, keyed by the SHA-256 of the stored photograph.
# SCENE_SURFACE_DEPTH_DIR=/data/surface-depth
# SCENE_SURFACE_MARKS_DIR=/data/surface-marks
# Optional image-capable Chat Completions endpoint (full URL including path).
# SCENE_PLANNER_URL=
# SCENE_PLANNER_MODEL=
# SCENE_PLANNER_KEY=
#
# MiniMax-H3-Image style redraw (dual engine: Cloud API and/or ComfyUI).
# MINIMAX_API_KEY=
# MINIMAX_API_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_IMAGE_MODEL=MiniMax-H3-Image
# Fixed local Colab ComfyUI Gateway (hot-takeover trycloudflare tunnels via POST /_gateway/set-upstream).
MINIMAX_H3_COMFY_URL=http://127.0.0.1:8188
# MINIMAX_H3_IMAGE_UNET=minimax_h3_image_pruned_int8_convrot.safetensors
# MINIMAX_H3_IMAGE_CLIP=qwen3vl_32b_minimax_h3_int8_convrot.safetensors
# MINIMAX_H3_IMAGE_VAE=minimax_h3_image_vae_fp16.safetensors
